<?xml version="1.0"?>
<ruleset name="Klinik Randevu">
    <description>PSR-12 kod biçimi</description>
    <file>src</file>
    <file>config</file>
    <file>bin</file>
    <file>public/index.php</file>
    <file>tests</file>
    <exclude-pattern>tests/Fixtures/*</exclude-pattern>
    <arg name="colors"/>
    <arg name="report" value="summary"/>
    <arg value="sp"/>
    <!-- Satır uzunluğu (>120) PSR-12de "SHOULD" düzeyindedir: uyarı olarak raporlanır, çıkış kodunu bozmaz -->
    <config name="ignore_warnings_on_exit" value="1"/>
    <rule ref="PSR12"/>
</ruleset>
