# Kopyalayın: cp .env.example .env
APP_PORT=8000
APP_ENV=development
# 1: hata ayrıntısı ekranda gösterilir (YALNIZCA yerel geliştirme), 0: kullanıcıya sade hata sayfası (varsayılan)
APP_DEBUG=0
# Süper yönetici (admin) şifresinin bcrypt hash'i. Boş bırakılırsa varsayılan şifre: asdf1234
# Üretmek için: docker compose exec app php -r 'echo password_hash("yeni-sifre", PASSWORD_DEFAULT), PHP_EOL;'
# Değeri tek tırnak içinde yazın ($ karakterleri yorumlanmasın).
SUPER_ADMIN_PASSWORD_HASH=
