{
    "name": "clinic/appointment-system",
    "description": "Klinik Randevu Sistemi - PHP Programlama dönem projesi (framework'süz, katmanlı mimari)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "lint-fix": "phpcbf",
        "check": [
            "@lint",
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
